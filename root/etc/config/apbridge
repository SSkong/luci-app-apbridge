# luci-app-apbridge
#
# 让 LAN 客户端访问处于其它子网的 AP（LAN 侧）或光猫（WAN 侧）。
#
# 原理：在目标设备所在子网里占用一个空闲地址，把它挂到路由器上，再由 wan 防火墙
# 区域做源地址转换。目标设备看到的是同网段地址，因此不需要它有回到 LAN 网段的路由。
#
# settings 段：
#   enabled   总开关
#
# channel 段（可多条，每条对应一条访问通道）：
#   name      显示名
#   side      lan = 目标在 LAN 侧（例如接在 LAN 口的 AP）
#             wan = 目标在 WAN 侧（例如 PPPoE 桥接的光猫）
#   target    目标设备管理地址，可选；填了才能在界面上做连通性测试和跳转
#   addr      虚拟地址，支持 IP/prefix、IP/NETMASK、纯 IP；纯 IP 按 24 位处理
#             （纯 IP 不能填 /32，那无法形成子网，脚本会跳过并写日志）

config settings 'settings'
	option enabled '0'

config channel 'ap'
	option name 'AP'
	option side 'lan'
	option enabled '1'
	option target '192.168.31.1'
	list addr '192.168.31.254/24'

config channel 'modem'
	option name 'Modem'
	option side 'wan'
	option enabled '1'
	option target '192.168.1.1'
	list addr '192.168.1.254/24'
