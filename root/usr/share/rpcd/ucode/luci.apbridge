#!/usr/bin/ucode
// luci-app-apbridge 后端
//
// 只做三件事，真正的配置手术在 /etc/init.d/apbridge 里（shell 处理 uci 更直接）：
//   status  读取当前生效状态（接口名、netifd 是否 up、实际下发的地址）
//   probe   对某个目标地址做 ping + HTTP 探测，用于界面上的连通性判断
//   apply   触发一次重新下发（内部就是 /etc/init.d/apbridge reload）
//
// 约定：本文件放在 /usr/share/rpcd/ucode/，rpcd 加载后暴露 ubus 对象 luci.apbridge。
// 前端每次调用都要在 /usr/share/rpcd/acl.d/luci-app-apbridge.json 里授权。
//
// ── 踩过的坑（务必看）─────────────────────────────────────────────────────
// uci.foreach(config, type, callback) 的回调参数是**整个 section 字典**，不是
// section 名。官方示例就是 `section => print(section[".name"])`。
// 早期版本把它当名字继续传 `uci.get(config, sec, opt)`，而 uci.get 的 C 实现会做
// 类型校验：
//     if (ucv_type(conf) != UC_STRING || (sect && ucv_type(sect) != UC_STRING))
//             err_return(UCI_ERR_INVAL);
// 于是 status 在遍历到第一个 channel 时就抛异常 → rpcd 回 UBUS_STATUS_UNKNOWN_ERROR
// → 前端 rpc 拿到 null → 页面显示「无法获取运行状态，请确认 rpcd 正在运行」。
// 现在统一用 section 字典本身取值（sec.name / sec.addr / sec['.name']）。

'use strict';

import { popen, access } from 'fs';
import { cursor } from 'uci';

const CONF = 'apbridge';
const IFPFX = 'apb';
const MAX_CH = 16;

// 执行命令并收集输出。rpcd 本身以 root 运行，权限不是问题，但入参必须自己校验。
function sh(cmd) {
	const fd = popen(cmd);
	let out = '';

	if (fd) {
		out = fd.read('all');
		if (out == null)
			out = '';
	}

	const rc = fd ? fd.close() : -1;

	return { out: out, rc: rc };
}

function trim(s) {
	return replace(s, /^\s+|\s+$/g, '');
}

// 命令行参数整体引用，避免主机名里混进 shell 语法
function shellquote(s) {
	return "'" + replace(s, "'", "'\\''") + "'";
}

function to_array(v) {
	if (v == null)
		return [];

	return type(v) == 'array' ? v : [v];
}

function uci_bool(v) {
	if (v == null)
		return false;

	if (v === true)
		return true;

	if (v === false)
		return false;

	return v == '1' || v == 'true' || v == 'yes' || v == 'on';
}

// 从 section 字典取标量选项：list 选项取第一个值，空值回落默认
function opt(sec, name, def) {
	let v = sec[name];

	if (type(v) == 'array')
		v = length(v) ? v[0] : null;

	if (v == null || v == '')
		return def;

	return v;
}

function errmsg(e) {
	if (type(e) == 'object' && e != null && e.message)
		return '' + e.message;

	return '' + e;
}

// netifd 的全部接口状态。一次调用拿全量，避免每个通道单独 fork。
function interface_dump() {
	const r = sh('ubus call network.interface dump');
	if (r.rc != 0 || trim(r.out) == '')
		return {};

	let data = null;
	try {
		data = json(r.out);
	}
	catch (e) {
		return {};
	}

	const map = {};
	for (const i in (data.interface || []))
		map[data.interface[i].interface] = data.interface[i];

	return map;
}

// LAN 侧是否需要 veth，取决于 LAN 设备是不是桥。不是桥时界面要给提示，
// 否则用户只会看到「通道没生效」却不知道原因。
function network_state(uci) {
	const lan = uci.get_all('network', 'lan') || {};
	const wan = uci.get_all('network', 'wan') || {};
	const ldev = lan.device || lan.ifname || '';
	let bridge = false;

	if (ldev) {
		uci.foreach('network', 'device', function (dev) {
			if (dev.name == ldev && dev.type == 'bridge') {
				bridge = true;
				return false;   /* 命中即停止遍历 */
			}

			return true;
		});
	}

	return {
		device: ldev,
		bridge: bridge,
		wan_device: wan.device || wan.ifname || ''
	};
}

const methods = {
	status: {
		call: function () {
			const uci = cursor();
			const result = {
				enabled: false,
				lan_device: '',
				lan_is_bridge: false,
				wan_device: '',
				channels: []
			};

			// 任何一处抛异常都不让整个 ubus 调用失败：回一个带 error 字段的字典，
			// 前端就能把真实原因显示出来，而不是笼统的「无法获取运行状态」。
			try {
				const dump = interface_dump();
				const net = network_state(uci);
				const settings = uci.get_all(CONF, 'settings') || {};

				result.enabled = uci_bool(settings.enabled);
				result.lan_device = net.device;
				result.lan_is_bridge = net.bridge;
				result.wan_device = net.wan_device;

				let idx = 0;

				uci.foreach(CONF, 'channel', function (sec) {
					idx++;
					if (idx > MAX_CH)
						return false;

					const ifname = IFPFX + idx;
					const dev = dump[ifname];
					const active = [];

					if (dev) {
						for (const a in (dev['ipv4-address'] || []))
							push(active, dev['ipv4-address'][a].address + '/' + dev['ipv4-address'][a].mask);
					}

					push(result.channels, {
						index: idx,
						section: sec['.name'],
						name: opt(sec, 'name', 'channel' + idx),
						side: opt(sec, 'side', 'lan'),
						enabled: (sec.enabled == null) ? true : uci_bool(sec.enabled),
						target: opt(sec, 'target', ''),
						ifname: ifname,
						configured: to_array(sec.addr),
						active: active,
						present: dev != null,
						up: dev != null && dev.up === true
					});

					return true;
				});
			}
			catch (e) {
				result.error = errmsg(e);
			}

			uci.unload();

			return result;
		}
	},

	probe: {
		args: { host: 'string' },
		call: function (request) {
			const host = trim(request.args.host || '');

			// 只放行 IP 或主机名允许的字符，随后再整体引用，双保险
			if (!match(host, /^[A-Za-z0-9._-]{1,253}$/))
				return { ok: false, error: 'invalid host' };

			const res = { ok: true, host: host, ping: false, http: null, http_code: null };

			try {
				const p = sh('ping -c 1 -W 2 ' + shellquote(host));
				res.ping = (p.rc == 0);

				// 管理页面基本都是 HTTP。curl 优先（能拿到状态码），退而用 wget。
				if (access('/usr/bin/curl')) {
					const c = sh('curl -sS -o /dev/null -m 4 -w "%{http_code}" http://' + shellquote(host));
					const code = trim(c.out);

					if (code != '' && code != '000') {
						res.http = true;
						res.http_code = +code;
					}
					else {
						res.http = false;
					}
				}
				else if (access('/usr/bin/wget') || access('/bin/wget')) {
					const w = sh('wget -q -T 4 -O /dev/null http://' + shellquote(host));
					res.http = (w.rc == 0);
				}
			}
			catch (e) {
				res.ok = false;
				res.error = errmsg(e);
			}

			return res;
		}
	},

	apply: {
		call: function () {
			try {
				const r = sh('/etc/init.d/apbridge reload 2>&1');
				return {
					ok: (r.rc == 0),
					code: r.rc,
					output: trim(r.out)
				};
			}
			catch (e) {
				return { ok: false, code: -1, output: errmsg(e) };
			}
		}
	}
};

return { 'luci.apbridge': methods };
